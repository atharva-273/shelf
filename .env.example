# Optional. Everything works without this — Open Library is the primary source.
#
# Adding a Google Books key improves summaries and search relevance. Keyless
# requests get a hard 429 from most IPs, so without a key the app skips Google
# entirely (there's a circuit breaker) and runs on Open Library alone.
#
# Get one at https://console.cloud.google.com → enable "Books API" → Credentials.
# Restrict it by HTTP referrer: it ships in the client bundle.
VITE_GOOGLE_BOOKS_KEY=
